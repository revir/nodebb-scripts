# Copy this file to restore.env and fill in your own values.
# restore.env is gitignored, so your server info never ends up in the repo.

# Remote server that holds the backups
REMOTE_HOST=your.server.ip
REMOTE_USER=youruser
REMOTE_PORT=22
# quote it so ~ expands on the remote server, not locally
REMOTE_BACKUPS_DIR='~/backups'

# Where downloaded backups are stored locally
LOCAL_BACKUPS_DIR=$HOME/backups

# Local NodeBB install (public/uploads is restored into it)
NODEBB_DIR=$HOME/workspace/NodeBB

# Local mongodb; leave MONGO_USER empty if auth is disabled
MONGO_HOST=localhost:27017
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_DB=nodebb
